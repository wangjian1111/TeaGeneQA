{
  "schema_version": "1.1",
  "external_model_enabled": false,
  "result_envelope_schema": {
    "$defs": {
      "ToolError": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "details": {
            "default": null,
            "title": "Details"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ToolError",
        "type": "object"
      }
    },
    "properties": {
      "tool": {
        "title": "Tool",
        "type": "string"
      },
      "status": {
        "enum": [
          "ok",
          "empty",
          "ambiguous",
          "not_found",
          "invalid_arguments",
          "unavailable",
          "unknown_tool",
          "insufficient_evidence"
        ],
        "title": "Status",
        "type": "string"
      },
      "data": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "title": "Data"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ToolError"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "evidence_policy": {
        "additionalProperties": true,
        "title": "Evidence Policy",
        "type": "object"
      }
    },
    "required": [
      "tool",
      "status",
      "data",
      "evidence_policy"
    ],
    "title": "ToolResult",
    "type": "object"
  },
