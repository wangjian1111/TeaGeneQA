# 格式示例。请运行 python scripts/setup_compose_env.py 生成随机密码与 0600 权限文件。
# 不执行变量插值；不要把真实密码提交到代码库。
TEAGENEQA_DATABASE_MODE=docker
POSTGRES_PASSWORD=
TEAGENEQA_DB_PORT=55433
TEAGENEQA_API_PORT=18000
TEAGENEQA_API_URL=http://127.0.0.1:18000
TEAGENEQA_WEB_PORT=18501
# 显式 DATABASE_URL 的优先级高于以上字段；通常不需要设置。
# 原生库恢复：TEAGENEQA_DATABASE_MODE=native
